# OpenRouter API Key (Get a free key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-duplicate-placeholder-key-replace-later

# Preferred model (Default: Qwen 2.5 Coder 32B Free or Nemotron Free)
OPENROUTER_MODEL=openrouter/qwen/qwen-2.5-coder-32b-instruct:free

# GitHub Personal Access Token (Optional: Increases rate limit from 60 to 5000 req/hr)
# Generate from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_duplicate_placeholder_token_replace_later

# Fallback mode: When keys are placeholders or API quota is reached, use intelligent fallback
USE_MOCK_FALLBACK=true

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auditagent
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/auditagent

# Security & Authentication
SECRET_KEY=change_this_to_a_random_32_byte_secret
ENCRYPTION_KEY=change_this_to_a_fernet_compatible_key
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
ACCESS_TOKEN_EXPIRE_MINUTES=1440
